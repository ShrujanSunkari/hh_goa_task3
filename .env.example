# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  Face-ID & Blockchain Verification Pipeline
#  Copy this file to ".env" and fill in your actual values.
#  NEVER commit ".env" to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Keys ─────────────────────────────────────────────────────────────────
# SerpAPI key for Google Lens visual search
SERPAPI_KEY=your_serpapi_key_here
# Authentication key for your own FastAPI server
API_KEY=your_secret_api_key_here

# ── Ethereum / Web3 Provider ─────────────────────────────────────────────────
# Local dev  → leave blank or use "evm://"  (py-evm in-process, zero cost)
# Testnet    → e.g. https://sepolia.infura.io/v3/<PROJECT_ID>
# Mainnet    → e.g. https://mainnet.infura.io/v3/<PROJECT_ID>
# WEB3_PROVIDER_URI=evm://
# Please use your Sepolia RPC URL (e.g. Infura/Alchemy) for verification.

# ── Wallet / Signer ──────────────────────────────────────────────────────────
# Raw hex private key (with or without 0x prefix)
# For local demo the deployer account is auto-generated — leave blank.
PRIVATE_KEY=your_private_key_here

# ── Deployed Contract ────────────────────────────────────────────────────────
# Filled automatically by deploy.py after first deployment.
# Override manually if you already have a live contract.
CONTRACT_ADDRESS=0x547c457d9c1d7d52825d4e0d9cd56cff5d527f58
